{
  "name": "Transfer - Initiate Transfer (success)",
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/api/v1/transfers",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.fromAccount",
          "equalTo": "ACC-001"
        }
      },
      { "matchesJsonPath": "$.toAccount" },
      { "matchesJsonPath": "$.amount" },
      { "matchesJsonPath": "$.currency" },
      { "matchesJsonPath": "$.reference" }
    ]
  },
  "response": {
    "status": 202,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "transfer/transfer-accepted-response.json"
  }
}
