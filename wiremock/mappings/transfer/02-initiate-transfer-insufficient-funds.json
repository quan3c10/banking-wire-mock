{
  "name": "Transfer - Initiate Transfer (insufficient funds)",
  "priority": 0,
  "request": {
    "method": "POST",
    "url": "/api/v1/transfers",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.fromAccount == 'ACC-001' && @.amount == 99999.99)]"
      }
    ]
  },
  "response": {
    "status": 422,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "transfer/transfer-insufficient-funds-response.json"
  }
}
