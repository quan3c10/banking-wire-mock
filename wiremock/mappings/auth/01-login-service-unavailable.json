{
  "name": "Auth - Login Service Unavailable (fault trigger)",
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/api/v1/auth/login",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.username",
          "equalTo": "trigger.outage"
        }
      }
    ]
  },
  "response": {
    "status": 503,
    "headers": {
      "Content-Type": "application/json",
      "Retry-After": "30"
    },
    "bodyFileName": "auth/login-service-unavailable-response.json"
  }
}
