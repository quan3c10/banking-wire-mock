{
  "name": "Auth - Get Current User (authorized)",
  "priority": 1,
  "request": {
    "method": "GET",
    "url": "/api/v1/auth/me",
    "headers": {
      "Authorization": {
        "matches": "Bearer eyJ.+"
      }
