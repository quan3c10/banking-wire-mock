{
  "name": "Auth - Refresh Token",
  "request": {
    "method": "POST",
    "url": "/api/v1/auth/refresh",
    "bodyPatterns": [
      { "matchesJsonPath": "$.refreshToken" }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "auth/refresh-token-response.json"
  }
}
