{
  "name": "Auth - Logout",
  "request": {
    "method": "POST",
    "url": "/api/v1/auth/logout",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "auth/logout-response.json"
  }
}
